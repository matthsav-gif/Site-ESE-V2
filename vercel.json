{
  "buildCommand": "npm run check",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ese-techsolutions.com"
        }
      ],
      "destination": "https://ese-techsolutions.com/:path*",
      "permanent": true
    },
    {
      "source": "/corestage",
      "destination": "https://corestage.fr",
      "permanent": false
    },
    {
      "source": "/beat-per-light",
      "destination": "https://www.beatperlight.com",
      "permanent": false
    },
    {
      "source": "/cobel",
      "destination": "https://www.cobel.fr/",
      "permanent": false
    }
  ]
}
