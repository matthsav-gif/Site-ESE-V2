---
import fs from "node:fs";
import "../styles/ese.css";
import "../styles/legacy.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const {
  title = "ESE · Event & Safety Engineering",
  description = "Société d'ingénierie pour la production technique événementielle.",
  ogImage = "/images/jo-para.webp",
  schema = [],
  type = "website",
  lang = "fr",
} = Astro.props;

const site = "https://ese-techsolutions.com";
const canonical = new URL(Astro.url.pathname, site).href;
// Versions FR / EN de la même page (pas d'équivalent anglais pour les pages légales FR)
const FR_ONLY = ["/mentions-legales", "/confidentialite"];
// Rubriques sans version anglaise : pas de hreflang ni de lien de langue vers une page inexistante
const FR_ONLY_PREFIX = ["/journal"];
const pth = Astro.url.pathname.replace(/\/$/, "") || "/";
const frPath = pth === "/en" ? "/" : pth.replace(/^\/en(?=\/)/, "");
const hasEn = !FR_ONLY.includes(frPath) && !FR_ONLY_PREFIX.some((x) => frPath.startsWith(x));
const enPath = frPath === "/" ? "/en" : "/en" + frPath;
// Réseaux sociaux : certains ne lisent pas le WebP, on sert l'original JPEG/PNG quand il existe.
const ogBase = ogImage.replace(/\.webp$/, "");
const ogFile = [".jpg", ".jpeg", ".png", ".JPG"].map((x) => ogBase + x).find((p) => fs.existsSync("public" + p)) || ogImage;
const ogImageAbs = new URL(ogFile, site).href;

// --- Données structurées (SEO + lisibilité par les IA) ---
const orgLd = {
  "@context": "https://schema.org",
  "@type": ["Organization", "ProfessionalService"],
  "@id": `${site}/#organization`,
  name: "Event & Safety Engineering",
  alternateName: "ESE",
  url: site,
  logo: `${site}/logo-ese.png`,
  image: `${site}/images/jo-para.webp`,
  description:
    "Société d'ingénierie pour la production technique événementielle. Direction technique, régie générale et expertise sécurité ERP, sur les productions live, événementielles et institutionnelles.",
  slogan: "Société d'ingénierie pour la production technique événementielle.",
  founder: { "@type": "Person", name: "Matthieu Savatier" },
  address: {
    "@type": "PostalAddress",
    streetAddress: "15 rue des Halles",
    postalCode: "75001",
    addressLocality: "Paris",
    addressCountry: "FR",
  },
  telephone: "+33184808069",
  email: "secretariat@ese-techsolutions.com",
  areaServed: [{ "@type": "Country", name: "France" }, "International"],
  knowsAbout: [
    "Direction technique événementielle",
    "Régie générale",
    "Stage management",
    "Bureau d'études événementiel",
    "Notes de calcul de structures",
    "Design lumière",
    "Expertise sécurité ERP",
    "Notice de sécurité ERP",
    "Commission de sécurité",
    "Qualification AP2 ENSOSP",
    "Rigging et calculs de structures",
    "Vectorworks", "Braceworks", "ConnectCAD", "MVR",
    "Scénographie", "Production live", "Tournées en stade",
  ],
  sameAs: [
    "https://www.linkedin.com/company/event-safety-engineering/",
  ],
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+33184808069",
    email: "secretariat@ese-techsolutions.com",
    contactType: "sales",
    areaServed: "FR",
    availableLanguage: ["French", "English"],
  },
};

const siteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site}/#website`,
  url: site,
  name: "ESE · Event & Safety Engineering",
  publisher: { "@id": `${site}/#organization` },
  inLanguage: lang === "en" ? "en-GB" : "fr-FR",
};

const allSchema = [orgLd, siteLd, ...schema];
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Favicon adaptatif : noir sur thème clair, blanc sur thème sombre */}
    <link rel="icon" type="image/png" href="/favicon-noir.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href="/favicon-blanc.png" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href="/favicon-noir.png" />
    <link rel="apple-touch-icon" href="/favicon-noir.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hasEn && <link rel="alternate" hreflang="fr" href={new URL(frPath, site).href} />}
    {hasEn && <link rel="alternate" hreflang="en" href={new URL(enPath, site).href} />}
    {hasEn && <link rel="alternate" hreflang="x-default" href={new URL(frPath, site).href} />}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="author" content="Event & Safety Engineering" />
    <meta name="generator" content="Astro" />
    <meta name="google-site-verification" content="7Ttk_drz0BbWwr-MlAV7M9Qw7S00WJSDrVNGO26nFE4" />
    <meta name="msvalidate.01" content="2EDB8207472934173FD0F0CAB61660B8" />

    {/* Indique aux IA / agents une version texte du site */}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt , résumé du site pour les IA" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=IBM+Plex+Mono:wght@400;500;600&display=swap" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content={lang === "en" ? "en_GB" : "fr_FR"} />
    <meta property="og:site_name" content="ESE · Event & Safety Engineering" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:alt" content="ESE · Event & Safety Engineering" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    {allSchema.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
      <!-- Mesure d'audience Vercel Web Analytics : sans cookie, à activer dans le projet Vercel (onglet Analytics). -->
    <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === "en" ? "Skip to content" : "Aller au contenu"}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script src="/ese.js" is:inline defer></script>
  </body>
</html>
