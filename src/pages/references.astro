---
import { readdirSync } from "node:fs";
import { fileURLToPath } from "node:url";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactBanner from "../components/ContactBanner.astro";
import VideoFacade from "../components/VideoFacade.astro";
import { REFERENCES, SEO } from "../data/site.js";

// Galerie : lit automatiquement toutes les images de public/images/galerie/
const galerieDir = fileURLToPath(new URL("../../public/images/galerie", import.meta.url));
let galerie = [];
try {
  galerie = readdirSync(galerieDir)
    .filter((f) => /\.(jpe?g|png|webp)$/i.test(f))
    .sort()
    .map((f) => `/images/galerie/${f}`);
} catch (e) {}
---
<BaseLayout title={SEO.references.title} description={SEO.references.description}>
  <section class="phero">
    <div class="phero__deco"></div>
    <div class="phero__grid" style="grid-template-columns:1fr;max-width:1320px">
      <div style="max-width:26ch">
        <span class="eyebrow">Références</span>
        <h1 style="margin-top:22px">Références.</h1>
        <p class="phero__sub" style="max-width:52ch">Une sélection de productions menées par ESE, Event &amp; Safety Engineering.</p>
      </div>
    </div>
  </section>

  {/* Mosaïque */}
  <section class="section section--tight">
    <div class="wrap">
      <div class="refgrid">
        {REFERENCES.map((r, k) => (
          <div class={"refcard reveal " + r.span} data-d={(k % 2) + 1}>
            {r.src ? (
              <div class="refcard__img"><img src={r.src} alt={r.names} loading="lazy" decoding="async" /></div>
            ) : (
              <div class={"ph ph--" + r.variant}><div class="ph__media"></div></div>
            )}
            <div class="refcard__scrim"></div>
            <div class="refcard__body">
              <div class="refcard__k">{r.placeholderNote || (r.src ? r.k : "visuel à fournir")}</div>
              <div class="refcard__t">{r.k}</div>
              <div class="refcard__d">{r.names}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Détail des grappes */}
  <section class="section section--tight" style="background:var(--paper-2)">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:12px">
        <span class="eyebrow">Cinq familles de productions</span>
      </div>
      {REFERENCES.map((r, k) => (
        <div class="split reveal" data-d={(k % 2) + 1}
          style="grid-template-columns:320px 1fr;padding:30px 0;border-top:1px solid rgba(44,62,80,.14);align-items:baseline">
          <div>
            <div class="mono" style="color:var(--taupe-deep);font-size:12px">{String(k + 1).padStart(2, "0")}, {r.k}</div>
            <h3 class="display" style="font-size:22px;margin-top:12px;line-height:1.12">{r.t}</h3>
          </div>
          <div>
            <p style="margin:0;color:var(--navy);font-size:18px">{r.names}</p>
            <p style="margin-top:10px;color:var(--slate);font-weight:300">{r.desc}</p>
            {r.videos && (
              <div class="vgrid" style="margin-top:22px">
                {r.videos.map((v) => <VideoFacade id={v.id} title={v.title} />)}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* Et au quotidien */}
  <section class="section">
    <div class="wrap split">
      <div class="reveal col-head">
        <span class="eyebrow">Et au quotidien</span>
        <h2>Au-delà des productions phares.</h2>
      </div>
      <div>
        <p class="reveal lead" style="margin-top:0">
          Au-delà de ces productions phares, ESE intervient au quotidien auprès de marques, agences, lieux culturels et entreprises sur leurs dossiers de production, événementiel corporate, scène, captation, scénographie, expo, lancements produits, conventions. Sur des formats de moyenne envergure comme sur des opérations confidentielles.
        </p>
        <p class="reveal" data-d="1" style="margin-top:22px">
          ESE accompagne agences événementielles, producteurs et organisateurs de spectacles, bureaux d'études techniques, scénographes et donneurs d'ordre institutionnels.
        </p>
      </div>
    </div>
  </section>

  {/* Galerie complète */}
  {galerie.length > 0 && (
    <section class="section section--tight" style="background:var(--paper-2)">
      <div class="wrap">
        <div class="reveal" style="margin-bottom:36px;max-width:60ch">
          <span class="eyebrow">Galerie</span>
          <h2 class="display" style="font-size:clamp(24px,2.6vw,38px);margin-top:16px;line-height:1.1">En images.</h2>
          <p class="lead" style="margin-top:16px">Productions, montages, structures et scénographies, un aperçu du quotidien d'ESE.</p>
        </div>
        <div class="gallery" id="gallery">
          {galerie.map((src, i) => (
            <button class="gallery__item" data-src={src} data-i={i} aria-label={`Agrandir l'image ${i + 1}`}>
              <img src={src} alt={`Production ESE, visuel ${i + 1}`} loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lightbox__close" id="lb-close" aria-label="Fermer">✕</button>
    <button class="lightbox__nav lightbox__prev" id="lb-prev" aria-label="Précédent">‹</button>
    <img id="lb-img" src="" alt="" />
    <button class="lightbox__nav lightbox__next" id="lb-next" aria-label="Suivant">›</button>
  </div>

  <ContactBanner />
</BaseLayout>

<script>
  const items = Array.from(document.querySelectorAll("#gallery .gallery__item"));
  const lb = document.getElementById("lightbox");
  const lbImg = document.getElementById("lb-img");
  let cur = 0;
  const srcs = items.map((b) => b.dataset.src);
  function show(i) { cur = (i + srcs.length) % srcs.length; lbImg.src = srcs[cur]; }
  function open(i) { show(i); lb.classList.add("open"); lb.setAttribute("aria-hidden", "false"); }
  function close() { lb.classList.remove("open"); lb.setAttribute("aria-hidden", "true"); lbImg.src = ""; }
  items.forEach((b) => b.addEventListener("click", () => open(Number(b.dataset.i))));
  document.getElementById("lb-close")?.addEventListener("click", close);
  document.getElementById("lb-prev")?.addEventListener("click", (e) => { e.stopPropagation(); show(cur - 1); });
  document.getElementById("lb-next")?.addEventListener("click", (e) => { e.stopPropagation(); show(cur + 1); });
  lb?.addEventListener("click", (e) => { if (e.target === lb) close(); });
  document.addEventListener("keydown", (e) => {
    if (!lb.classList.contains("open")) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowLeft") show(cur - 1);
    if (e.key === "ArrowRight") show(cur + 1);
  });

  // Vidéos YouTube, charge l'iframe au clic
  document.querySelectorAll(".vfacade").forEach((f) => {
    f.addEventListener("click", () => {
      const id = f.dataset.youtube;
      if (!id || f.querySelector("iframe")) return;
      const ifr = document.createElement("iframe");
      ifr.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      ifr.title = f.querySelector(".vfacade__title")?.textContent || "Vidéo";
      ifr.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      ifr.allowFullscreen = true;
      f.appendChild(ifr);
    });
  });
</script>
