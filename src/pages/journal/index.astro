---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { dt } from "../../data/v3.js";
// Journal de terrain : retours d'exploitation tirés des posts publiés, regroupés par thème. Le plus récent en premier.
const A = [
  ["meteo-evenement-plein-air", "Météo et plein air : qui décide d'arrêter", "Octobre 2026", "Un site en plein air sous tempête, des seuils écrits, une cellule de décision : comment ESE prépare la décision météo."],
  ["note-de-calcul-design-lumiere-amont", "La technique se décide en amont", "Octobre 2026", "Note de calcul et design lumière : charges, accroches et lestage se règlent avant le montage, pas sur site."],
  ["planning-pilotage-production", "Du plan au terrain : piloter, pas seulement planifier", "Octobre 2026", "Un plan décrit une intention, un planning un ordre. Ce qui pilote une production se joue sur le terrain."],
  ["logistique-staff-evenementiel", "La logistique staff, le métier invisible", "Octobre 2026", "Plannings, accès, badges, relèves, repas : le poste qu'on ne voit jamais sur les photos."],
  ["retour-experience-fin-de-projet", "Après le show : le retour d'expérience", "Octobre 2026", "Après A$AP Rocky à l'Accor Arena : une heure pour ranger l'expérience avant de l'oublier."],
];
---
<BaseLayout title="Journal de terrain · ESE" description="Retours d'exploitation d'ESE sur la production technique événementielle : météo, coordination, régie, sécurité. Ce qu'on a vu sur le terrain et ce qu'on en retient." lang="fr">
  <section class="poster"><div class="wrap" style="display:block">
    <p class="kick">Journal de terrain</p>
    <h1 class="hl lg" style="margin-top:30px" set:html={dt("Ce que le terrain<br>nous apprend")} />
    <div class="doors three" style="margin-top:56px">{A.map(([s, t, m, d], i) => <a class="door" href={`/journal/${s}`}><b>{String(i + 1).padStart(2, "0")}</b><h2 style="font-variation-settings:'wdth' 72;font-weight:850;text-transform:uppercase;font-size:clamp(28px,2.4vw,40px);line-height:.92;margin:22px 0 12px">{t}</h2><p><small style="display:block;margin-bottom:8px;opacity:.6;text-transform:uppercase;letter-spacing:.12em;font-size:12px">{m}</small>{d}</p><span class="arrow">Lire <i>→</i></span></a>)}</div>
  </div></section>
</BaseLayout>
