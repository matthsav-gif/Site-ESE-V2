---
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactBanner from "../components/ContactBanner.astro";
import Photo from "../components/Photo.astro";
import { SEO } from "../data/site.js";

// Affiche le portrait dès que le fichier est déposé dans public/images/,
// sinon le placeholder charte (jamais d'image cassée).
const portraitFile = "portrait-matthieu.jpg";
const portraitPath = fileURLToPath(new URL(`../../public/images/${portraitFile}`, import.meta.url));
const portraitSrc = existsSync(portraitPath) ? `/images/${portraitFile}` : null;

const site = "https://ese-techsolutions.com";
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Matthieu Savatier",
  jobTitle: "Fondateur — Event & Safety Engineering",
  worksFor: { "@id": `${site}/#organization` },
  image: portraitSrc ? `${site}${portraitSrc}` : undefined,
  sameAs: ["https://www.linkedin.com/in/matthieu-savatier/"],
  knowsAbout: [
    "Direction technique événementielle", "Régie générale", "Expertise sécurité ERP",
    "Qualification AP2 ENSOSP", "Vectorworks", "Braceworks", "Rigging et calculs de structures",
  ],
  alumniOf: "Team France Vectorworks (Oliverdy)",
};

const qualifs = [
  { t: "AP2 ENSOSP", d: "Attestation de Compétence — prévention incendie et de panique pour les ERP et IGH." },
  { t: "Vectorworks", d: "Expertise de l'écosystème de conception technique événementielle." },
  { t: "Structures & rigging", d: "Compétences calculs de structures — Braceworks, MVR." },
];
---
<BaseLayout title={SEO.qui.title} description={SEO.qui.description} type="profile" schema={[personLd]}>
  <section class="phero">
    <div class="phero__deco"></div>
    <div class="phero__grid">
      <div>
        <span class="eyebrow">Qui sommes-nous</span>
        <h1 style="margin-top:22px">Qui sommes-nous.</h1>
        <p class="phero__sub">ESE est portée par son fondateur, Matthieu Savatier.</p>
      </div>
      <div class="phero__media" style="aspect-ratio:4/5;max-width:380px;justify-self:end">
        <Photo src={portraitSrc} alt="Matthieu Savatier, fondateur d'ESE — Event & Safety Engineering" label="Portrait Matthieu Savatier" file="portrait à intégrer" variant="" loading="eager" />
      </div>
    </div>
  </section>

  {/* Le fondateur */}
  <section class="section">
    <div class="wrap split">
      <div class="reveal col-head">
        <span class="eyebrow">Le fondateur</span>
        <h2>Matthieu Savatier.</h2>
      </div>
      <div>
        <p class="reveal lead" style="margin-top:0">
          Douze ans de production technique événementielle, des cérémonies des Jeux Olympiques de Paris 2024 aux tournées en stade et aux gros concerts internationaux, en passant par les grands défilés de mode et les événements institutionnels d'envergure internationale.
        </p>
        <p class="reveal" data-d="1" style="margin-top:22px">
          Avant ESE, j'ai exercé la direction technique et la régie générale chez Oliverdy, Paname 24, Impact Événement, REDITEC, DTE et au Puy du Fou International — sur des formats live, événementiels et patrimoniaux variés.
        </p>
        <p class="reveal" data-d="2" style="margin-top:22px">
          J'ai fondé ESE — Event &amp; Safety Engineering — en 2023 pour porter une activité d'ingénierie dédiée à la production technique événementielle, articulée autour de trois métiers : direction technique, régie générale et expertise sécurité.
        </p>
      </div>
    </div>
  </section>

  {/* Qualifications */}
  <section class="section section--tight" style="background:var(--paper-2)">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:32px"><span class="eyebrow">Qualifications</span></div>
      <div class="kgrid">
        {qualifs.map((q, k) => (
          <div class="kcell reveal" data-d={k + 1}>
            <div class="mono">QUALIF · {String(k + 1).padStart(2, "0")}</div>
            <h4>{q.t}</h4>
            <p>{q.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* L'entreprise + Réseau + Cibles */}
  <section class="section">
    <div class="wrap split">
      <div class="reveal col-head">
        <span class="eyebrow">L'entreprise</span>
        <h2>ESE — Event &amp; Safety Engineering.</h2>
      </div>
      <div>
        <p class="reveal lead" style="margin-top:0">
          ESE est une société d'ingénierie dédiée à la production technique événementielle, fondée en 2023.
        </p>
        <p class="reveal" data-d="1" style="margin-top:22px">
          ESE intervient en direction technique, régie générale et expertise sécurité, en portant des productions de bout en bout ou en complément d'équipes en place.
        </p>
        <p class="reveal" data-d="2" style="margin-top:22px">
          <strong style="font-weight:400;color:var(--navy)">Le réseau —</strong> ESE s'appuie sur une équipe de spécialistes mobilisée selon les projets — régisseurs, directeurs techniques, ingénieurs structure et préventionnistes — assemblée à façon pour chaque mission.
        </p>
        <p class="reveal" data-d="3" style="margin-top:22px">
          <strong style="font-weight:400;color:var(--navy)">Cibles —</strong> ESE accompagne agences événementielles, producteurs et organisateurs de spectacles, bureaux d'études techniques, scénographes et donneurs d'ordre institutionnels.
        </p>
      </div>
    </div>
  </section>

  <ContactBanner />
</BaseLayout>
