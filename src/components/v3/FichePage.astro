---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Strip from "./Strip.astro";
import ContactBanner from "../ContactBanner.astro";
import { T, SEO3, FICHES, REFS3, dt } from "../../data/v3.js";
const { lang = "fr", slug = "jo-paris-2024" } = Astro.props;
const en = lang === "en"; const b = T[lang].base;
const F = FICHES[slug]; const x = F[lang]; const S = SEO3[lang][F.seo];
const list = REFS3[lang].filter((r) => r.slug);
const idx = list.findIndex((r) => r.slug === slug); const nxt = list[(idx + 1) % list.length];
const count = `${String(idx + 1).padStart(2, "0")} / ${String(REFS3[lang].length).padStart(2, "0")}`;
---
<BaseLayout title={S.title} description={S.description} lang={lang} ogImage={F.img}>
  <section class="fhero">
    <div class="bg"><img src={F.img} alt={x.alt} fetchpriority="high" /></div>
    <div class="blue"></div>
    <div class="wrap"><p class="kick" style="color:#fff">{x.k}</p><h1 class="hl xl" style="color:#fff;margin-top:30px" set:html={dt(x.h1)} /></div>
  </section>
  <div class="wrap">
    <div class="facts rv">{x.facts.map(([k, v]) => <div><small>{k}</small><strong>{v}</strong></div>)}</div>
    {x.chaps.map(([n, t, p], i) => (
      <section class="chap rv"><h2><b>{n}</b>{t}</h2><div><p>{p}</p>
        {i === 2 && F.videos && <div class="videos">{F.videos.map(([id, k]) => <a class="video" href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener"><img src={`https://img.youtube.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" /><span>{x.v[k]}</span></a>)}</div>}
        {i === 2 && F.gallery && <div class="gallery">{F.gallery.map((g) => <img src={`/images/refs/${g}.webp`} alt="" loading="lazy" decoding="async" />)}</div>}
      </div></section>
    ))}
    <Strip left={en ? "ESE — References" : "ESE — Références"} count={count} next={nxt && nxt.slug !== slug ? `${b}/references/${nxt.slug}` : `${b}/references`} />
    <div style="height:80px"></div>
  </div>
  <ContactBanner lang={lang} title={x.cta} />
</BaseLayout>
