---
// Encadré noir « Les points clés » : 01 / 02 / 03
const { items = [], title = "Les points clés", row = false } = Astro.props;
---
<div class={"keys rv" + (row ? " row" : "")}>
  <p class="kt">{title}</p>
  <ol>{items.map(([a, b], i) => <li><b>{String(i + 1).padStart(2, "0")}</b><div><strong>{a}</strong><span>{b}</span></div></li>)}</ol>
</div>
