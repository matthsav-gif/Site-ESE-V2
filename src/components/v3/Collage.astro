---
// Composition photo N&B + aplats bleus (variantes a/b/c/d, comme les visuels de com)
const { img, v = "a", alt = "", tag = "" } = Astro.props;
const arc = (s) => `<svg class="arc" viewBox="0 0 200 200" style="${s}" aria-hidden="true"><circle cx="100" cy="100" r="98" fill="none" stroke="#1C45F2" stroke-width="1.4"/></svg>`;
const V = {
  a: { main: "inset:0 0 6% 12%", extra: `<div class="blue" style="left:4%;top:6%;width:24%;height:38%"></div><div class="gray" style="left:0;top:44%;width:16%;height:30%"></div><div class="cut" style="right:0;bottom:0;width:22%;height:14%"></div><div class="blue solid" style="right:4%;bottom:6%;width:12%;height:16%"></div><span class="cross" style="right:10%;top:9%"></span><span class="vline" style="left:62%;top:0;height:32%"></span><span class="dots" style="left:18%;bottom:14%"></span>${arc("right:-10%;bottom:-16%;width:44%")}` },
  b: { main: "inset:4% 6% 0 6%", extra: `<div class="blue" style="right:0;top:0;width:20%;height:46%"></div><div class="blue" style="left:0;bottom:12%;width:14%;height:22%"></div><div class="gray" style="left:6%;top:4%;width:18%;height:24%"></div><div class="cut" style="left:0;bottom:0;width:30%;height:10%"></div><span class="cross" style="left:14%;top:40%"></span><span class="vline" style="right:14%;top:0;height:100%"></span>${arc("left:-14%;bottom:-20%;width:52%")}` },
  c: { main: "inset:0 0 0 10%", extra: `<div class="blue" style="left:4%;top:0;width:30%;height:30%"></div><div class="gray" style="right:0;top:30%;width:14%;height:20%"></div><div class="blue" style="right:0;bottom:8%;width:9%;height:26%"></div><div class="cut" style="left:0;bottom:0;width:18%;height:24%"></div><span class="cross ink" style="left:3%;bottom:28%"></span><span class="cross" style="right:14%;top:8%"></span>${arc("left:10%;bottom:-24%;width:46%")}` },
  d: { main: "inset:0 4% 4% 14%", extra: `<div class="blue" style="left:8%;top:0;width:28%;height:30%"></div><div class="gray" style="right:0;top:4%;width:18%;height:20%"></div><div class="blue" style="left:4%;bottom:0;width:20%;height:32%"></div><div class="cut" style="right:0;bottom:0;width:24%;height:12%"></div><span class="cross" style="right:12%;top:30%"></span><span class="dots" style="right:4%;bottom:16%"></span>${arc("left:22%;bottom:-18%;width:40%")}` },
};
const c = V[v] || V.a;
---
<div class="collage rv">
  <div class="ph main" style={c.main}><img src={img} alt={alt} loading="lazy" decoding="async" /></div>
  <Fragment set:html={c.extra} />
  {tag && <span class="tag" style="right:7%;top:5%" set:html={tag} />}
</div>
