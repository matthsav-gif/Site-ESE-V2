---
// Bloc « Avis Google » : avis recopiés mot pour mot de la fiche Google publique (src/data/avis-google.json, 4 étoiles et plus), rendus dans la page.
import AVIS from "../../data/avis-google.json";
const { lang = "fr" } = Astro.props;
const en = lang === "en";
const tx = en
  ? { k: "Google reviews", t: "What our clients say", all: "See all reviews on Google", add: "Leave a review", n: "Google reviews", o: "Reviews shown in their original language." }
  : { k: "Avis Google", t: "Ce qu'en disent nos clients", all: "Voir tous les avis sur Google", add: "Laisser un avis", n: "avis Google", o: "" };
const note = en ? AVIS.rating.toFixed(1) : AVIS.rating.toFixed(1).replace(".", ",");
const stars = (n) => "★★★★★".slice(0, n) + "☆☆☆☆☆".slice(0, 5 - n);
---
{AVIS.reviews.length > 0 && (
<section class="poster avis-g" id="avis-google">
  <div class="wrap" style="display:block">
    <p class="kick">{tx.k}</p>
    <h2 class="hl md" style="margin-top:30px">{tx.t}<span class="nw"><span class="dot" aria-hidden="true"></span></span></h2>
    <p class="avis-score"><b>{note}</b> / 5 · {AVIS.count} {tx.n}</p>
    <div class="avis-list">
      {AVIS.reviews.map((r) => (
        <figure class="avis">
          <p class="stars" aria-label={`${r.rating} / 5`}>{stars(r.rating)}</p>
          <blockquote lang="fr">{r.text.split("\n").map((p) => <p>{p}</p>)}</blockquote>
          <figcaption>{r.author}</figcaption>
        </figure>
      ))}
    </div>
    {tx.o && <p class="avis-score" style="text-transform:none;letter-spacing:0">{tx.o}</p>}
    <p class="avis-links"><a class="arrow" href={AVIS.url} target="_blank" rel="noopener">{tx.all} <i>↗</i></a> <a class="arrow" href="https://g.page/r/CSgrdAaF2DWWEBI/review" target="_blank" rel="noopener">{tx.add} <i>↗</i></a></p>
  </div>
</section>
)}
