---
import { T, dt } from "../data/v3.js";
import { CONTACT } from "../data/site.js";
const { lang = "fr", title } = Astro.props;
const L = T[lang === "en" ? "en" : "fr"]; const C = L.contactBand;
---
<section class="dark band">
  <div class="wrap" data-g="s1">
    <div class="rv"><p class="kick">{C.kick}</p><h2 class="hl md" style="margin-top:30px;color:#fff" set:html={dt(title || C.title)} /></div>
    <div class="rv">
      <p style="font-size:20px;color:rgba(243,242,238,.85);max-width:40ch">{C.text}</p>
      <div style="display:flex;gap:26px;align-items:center;flex-wrap:wrap;margin-top:32px"><a href={`${L.base}/contact`} class="btn btn-blue">{C.cta} →</a><a href={CONTACT.telHref} class="arrow">{CONTACT.tel} <i>→</i></a></div>
    </div>
  </div>
</section>
