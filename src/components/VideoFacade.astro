---
/* Vignette YouTube cliquable — charge l'iframe au clic uniquement (performance). */
const { id, title } = Astro.props;
---
<div class="vfacade" data-youtube={id}>
  <img
    class="vfacade__thumb"
    src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
    alt={title}
    loading="lazy"
    decoding="async"
  />
  <button class="vfacade__play" type="button" aria-label={`Lire la vidéo : ${title}`}>
    <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
      <path d="M66.5 7.7c-.8-2.9-3-5.2-5.9-6C55.4.5 34 .5 34 .5S12.6.5 7.4 1.7c-2.9.8-5.1 3.1-5.9 6C.3 12.9.3 24 .3 24s0 11.1 1.2 16.3c.8 2.9 3 5.2 5.9 6C12.6 47.5 34 47.5 34 47.5s21.4 0 26.6-1.2c2.9-.8 5.1-3.1 5.9-6C67.7 35.1 67.7 24 67.7 24s0-11.1-1.2-16.3z" fill="#1E2B38"/>
      <path d="M27 34l18-10L27 14v20z" fill="#fff"/>
    </svg>
  </button>
  <span class="vfacade__title">{title}</span>
</div>
