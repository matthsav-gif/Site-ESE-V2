---
import { T } from "../data/v3.js";
import { CONTACT } from "../data/site.js";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isEn = path === "/en" || path.startsWith("/en/");
const L = T[isEn ? "en" : "fr"]; const base = L.base;
const isHome = path === "/" || path === "/en";
const FR_ONLY = ["/mentions-legales", "/confidentialite"];
const altLang = isEn ? (path.replace(/^\/en/, "") || "/") : (path === "/" || FR_ONLY.includes(path) || path.startsWith("/guides") || path.startsWith("/journal") ? "/en" : "/en" + path);
const items = [
  [`${base}/metiers`, L.nav.expertises, "/metiers"],
  [`${base}/references`, L.nav.refs, "/references"],
  [`${base}/methodes-partenariats`, L.nav.approche, "/methodes-partenariats"],
  [`${base}/qui-sommes-nous`, L.nav.about, "/qui-sommes-nous"],
];
const rel = isEn ? path.replace(/^\/en/, "") : path;
const cur = (k) => rel.startsWith(k);
---
<header class={"hdr" + (isHome ? " on-dark" : "")}>
  <div class="wrap">
    <nav aria-label={isEn ? "Main navigation" : "Navigation principale"}>
      {items.map(([h, t, k]) => <a href={h} aria-current={cur(k) ? "page" : undefined}>{t}</a>)}
    </nav>
    <a href={isEn ? "/en" : "/"} class="lockup" aria-label={isEn ? "ESE, home" : "ESE, accueil"}>
      <img src="/images/v3/logo.png" alt={isEn ? "ESE symbol" : "Symbole ESE"} width="54" height="53" /><span><b>ESE</b><small>Event &amp; Safety Engineering</small></span>
    </a>
    <div class="right">
      <a class="lang" href={altLang} lang={isEn ? "fr" : "en"} aria-label={isEn ? "Version française" : "English version"}>{isEn ? "FR" : "EN"}</a>
      <a href={`${base}/contact`} class={"btn " + (isHome ? "btn-line" : "btn-ink")}>{L.nav.cta}</a>
      <button class="menu-btn" aria-expanded="false" aria-controls="ov" data-open><i></i>{L.nav.menu}</button>
    </div>
  </div>
</header>
<div class="overlay" id="ov" role="dialog" aria-modal="true" aria-label={L.nav.menu}>
  <div class="top">
    <a href={isEn ? "/en" : "/"} class="lockup"><img src="/images/v3/logo.png" alt="" width="44" height="43" /><span><b>ESE</b><small>Event &amp; Safety Engineering</small></span></a>
    <button class="menu-btn" style="display:inline-flex" data-close>{L.nav.close} ✕</button>
  </div>
  <nav>
    {items.map(([h, t], i) => <a href={h}>{t}<span>{"0" + (i + 1)}</span></a>)}
    <a href={`${base}/contact`}>{L.nav.contact}<span>05</span></a>
  </nav>
  <div class="bottom"><a href={CONTACT.telHref}>{CONTACT.tel}</a><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a><a href={altLang}>{isEn ? "Version française" : "English version"}</a></div>
</div>
