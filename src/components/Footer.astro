---
import { T, METIERS3, dt } from "../data/v3.js";
import { CONTACT } from "../data/site.js";
const isEn = Astro.url.pathname.startsWith("/en");
const L = T[isEn ? "en" : "fr"]; const F = L.footer;
const M = METIERS3[isEn ? "en" : "fr"];
---
<footer class="ftr">
  <div class="wrap">
    <p class="big" aria-hidden="true" set:html={dt(F.big)} />
    <div class="ft-grid">
      <div>
        <a href={isEn ? "/en" : "/"} class="lockup"><img src="/images/v3/logo.png" alt="" width="54" height="53" style="filter:invert(1)" /><span><b>ESE</b><small>Event &amp; Safety Engineering</small></span></a>
        <p style="margin-top:18px">{F.about}</p>
      </div>
      <div><h5>{F.metiers}</h5>{M.map((m) => <a href={`${L.base}/metiers/${m.slug}`}>{m.t}</a>)}</div>
      <div><h5>{F.ese}</h5>{F.links.map(([h, t]) => <a href={h}>{t}</a>)}<a href="https://fse-incendie.fr" target="_blank" rel="noopener">{F.fse} ↗</a><a href={isEn ? "https://notmydpt.com/en" : "https://notmydpt.com/fr"} target="_blank" rel="noopener">{F.nmd} ↗</a></div>
      <div><h5>{F.contact}</h5><a href={CONTACT.telHref}>{CONTACT.tel}</a><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a><p>{CONTACT.adresse1}, {CONTACT.adresse2}</p><a href={CONTACT.linkedinEntreprise} target="_blank" rel="noopener noreferrer">LinkedIn ESE ↗</a></div>
    </div>
    <div class="ft-base"><span>© 2026 ESE · Event &amp; Safety Engineering · SOCLE® · COBEL®</span><span>{F.legal.map(([h, t], i) => <>{i > 0 && " · "}<a href={h}>{t}</a></>)}</span></div>
  </div>
</footer>
