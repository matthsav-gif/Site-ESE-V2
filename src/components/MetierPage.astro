---
// Page métier V3 (FR/EN) : visuel d'ouverture façon com + périmètre + références
import BaseLayout from "../layouts/BaseLayout.astro";
import Poster from "./v3/Poster.astro";
import Keys from "./v3/Keys.astro";
import RefRows from "./v3/RefRows.astro";
import Strip from "./v3/Strip.astro";
import ContactBanner from "./ContactBanner.astro";
import { T, METIERS3, METIER_V3, REFS3, SEO3, OFFRE, dt } from "../data/v3.js";
import { SEO } from "../data/site.js";
import { SEO as SEO_EN } from "../data/site.en.js";

const { route, lang = "fr" } = Astro.props;
const en = lang === "en";
const L = T[lang]; const b = L.base;
const M = METIERS3[lang]; const i = M.findIndex((x) => x.slug === route);
const m = M[i]; const d = METIER_V3[lang][route];
const N = M.length; const nxt = M[(i + 1) % N]; const prv = M[(i + N - 1) % N];
const own = REFS3[lang].filter((r) => (r.ms || []).includes(route));
const refs = (own.length ? own : REFS3[lang]).slice(0, 6);
const seo = (en ? SEO_EN : SEO)[route] || SEO3[lang][route];
const tx = en
  ? { livK: "Deliverables", livT: "What you receive", fmtK: "How we work", fmtT: "Four ways to bring us in", quote: "Request a quote", fmtNote: "No minimum budget. Reply within 2 working days.", whenK: "When to call us", whenT: "Typical situations", top: "Our services", perimK: "Scope", perimT: "What we take on", where: "Where we work", refK: "In action", refT: "References", all: "All references" }
  : { livK: "Livrables", livT: "Ce que vous recevez", fmtK: "Comment nous intervenons", fmtT: "Quatre façons de nous solliciter", quote: "Demander un devis", fmtNote: "Pas de budget minimum. Réponse sous 48 h ouvrées.", whenK: "Quand nous appeler", whenT: "Les situations types", top: "Nos métiers", perimK: "Périmètre", perimT: "Ce que nous prenons", where: "Là où nous intervenons", refK: "En situation", refT: "Références", all: "Toutes les références" };
const O = OFFRE[lang]; const FMT = ["renfort", "mission", "production", "annee"];
const svc = { "@context": "https://schema.org", "@type": "Service", name: m.t, description: d.lead, provider: { "@id": "https://ese-techsolutions.com/#organization" }, areaServed: ["France", "International"] };
---
<BaseLayout title={seo.title} description={seo.description} lang={lang} ogImage={m.img} schema={[svc]}>
  <Poster kick={m.kick} title={m.tl} sub={m.tag} img={m.img} v={m.v} alt="" top={[`${m.n} — ${tx.top}`, `${m.n} / ${m.of}`]} h1={true} cls="hl xl" tag={en ? "Anticipate<br>Coordinate<br>Deliver" : "Anticiper<br>Coordonner<br>Faire réussir"}>
    <Keys items={m.keys} title={L.keysTitle} />
  </Poster>

  <div class="wrap">
    <section class="intro2 rv"><p class="big">{d.lead}</p><div class="txt">{d.body.map((p) => <p>{p}</p>)}</div></section>
    <section class="whenS rv">
      <p class="kick">{tx.whenK}</p><h2 class="hl md" style="margin:28px 0 34px" set:html={dt(tx.whenT)} />
      <ol class="when">{d.when.map((w, k) => <li><b>{String(k + 1).padStart(2, "0")}</b><span>{w}</span></li>)}</ol>
    </section>
    <section class="perim rv">
      <div class="perim-h"><div><p class="kick">{tx.perimK}</p><h2 class="hl md" style="margin-top:28px" set:html={dt(tx.perimT)} /></div><a href={`${b}/contact?type=${route}`} class="btn btn-blue">{d.cta} →</a></div>
      <ol>{d.perim.map((p, k) => <li><b>{String(k + 1).padStart(2, "0")}</b>{p}</li>)}</ol>
    </section>
    {d.liv && (
      <section class="livS rv">
        <p class="kick">{tx.livK}</p><h2 class="hl md" style="margin:28px 0 30px" set:html={dt(tx.livT)} />
        <ul class="liv">{d.liv.map((x) => <li>{x}</li>)}</ul>
      </section>
    )}
    <section class="fmtS rv">
      <div class="perim-h"><div><p class="kick">{tx.fmtK}</p><h2 class="hl md" style="margin-top:28px" set:html={dt(tx.fmtT)} /></div><a href={`${b}/contact?type=${route}`} class="btn btn-blue">{tx.quote} →</a></div>
      <div class="fmts">{O.how.map(([t, x], k) => <a href={`${b}/contact?type=${route}&format=${FMT[k]}`}><b>{String(k + 1).padStart(2, "0")}</b><strong>{t}</strong><span>{x}</span></a>)}</div>
      <p class="portes-note">{tx.fmtNote}</p>
    </section>
  </div>

  {d.qualif && (
    <section class="dark band"><div class="wrap qualif rv">
      <div><p class="badge">AP2</p><p class="label" style="margin-top:18px">ENSOSP · {en ? "Fire prevention" : "Prévention"}</p></div>
      <div><h2 class="hl sm" style="color:#fff" set:html={dt(d.qualif.title)} /><p style="margin-top:22px;color:rgba(243,242,238,.82);font-size:18px">{d.qualif.text}</p></div>
    </div></section>
  )}

  <section class="dark band"><div class="wrap rv">
    <p class="kick">{d.opsT}</p><h2 class="hl md" style="margin-top:28px;color:#fff" set:html={dt(tx.where)} />
    <div class="ops">{d.ops.map((o) => <span>{o}</span>)}</div>
  </div></section>

  <section class="poster" style="padding-bottom:40px"><div class="wrap" style="display:block">
    <div class="rv" style="display:flex;justify-content:space-between;align-items:end;gap:30px;flex-wrap:wrap"><div><p class="kick">{tx.refK}</p><h2 class="hl md" style="margin-top:28px" set:html={dt(tx.refT)} /></div><a href={`${b}/references`} class="arrow">{tx.all} <i>→</i></a></div>
  </div></section>
  <section class="dark band" style="padding-top:20px"><div class="wrap"><div class="reflist" style="margin-top:0"><RefRows refs={refs} base={b} lang={lang} /></div></div></section>

  <div class="wrap">
    <nav class="next" aria-label={en ? "Other services" : "Autres métiers"}>
      <a href={`${b}/metiers/${prv.slug}`}><small>← {prv.n} / {prv.of}</small><strong>{prv.t}</strong></a>
      <a href={`${b}/metiers/${nxt.slug}`}><small>{nxt.n} / {nxt.of} →</small><strong>{nxt.t}</strong></a>
    </nav>
    <Strip left={`ESE — ${m.t}`} count={`${m.n} / ${m.of}`} next={`${b}/metiers/${nxt.slug}`} />
    <div style="height:80px"></div>
  </div>
  <ContactBanner lang={lang} />
</BaseLayout>
