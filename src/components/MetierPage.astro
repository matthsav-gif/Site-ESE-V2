---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactBanner from "./ContactBanner.astro";
import RefList from "./RefList.astro";
import { METIER_DATA as MD_FR, SEO as SEO_FR, PROCESS as PROCESS_FR } from "../data/site.js";
import { METIER_DATA as MD_EN, SEO as SEO_EN, PROCESS as PROCESS_EN } from "../data/site.en.js";

const { route, lang = "fr" } = Astro.props;
const isEn = lang === "en";
const d = isEn ? MD_EN[route] : MD_FR[route];
const seo = isEn ? SEO_EN[route] : SEO_FR[route];
const PROCESS = isEn ? PROCESS_EN : PROCESS_FR;
const isSecu = route === "expertise-securite";
const site = "https://ese-techsolutions.com";

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: d.h1.replace(/\.$/, ""),
  serviceType: d.h1.replace(/\.$/, ""),
  description: seo.description,
  provider: { "@id": `${site}/#organization` },
  areaServed: [{ "@type": "Country", name: "France" }, "International"],
  url: `${site}${Astro.url.pathname}`,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: d.perimTitle,
    itemListElement: d.perim.map((p) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: p.replace(/\.$/, "") },
    })),
  },
};
---
<BaseLayout title={seo.title} description={seo.description} ogImage={d.media.src || "/images/jo-para.jpg"} schema={[serviceLd]}>
  {/* HERO — carrousel plein écran */}
  <section class="hero">
    <div class="hero__bg" id="hero-bg">
      {d.heroSlides.map((s, k) => (
        <div class={"hero__slide" + (k === 0 ? " on" : "")}>
          <div class="hero__media" style={`background-image:url('${s.src}')`} role="img" aria-label={s.alt}></div>
        </div>
      ))}
    </div>
    <div class="hero__scrim"></div>
    <div class="hero__index" id="hero-index">01 / {String(d.heroSlides.length).padStart(2, "0")}</div>
    <div class="hero__dots" id="hero-dots">
      {d.heroSlides.map((_, k) => (
        <button class={"hero__dot" + (k === 0 ? " on" : "")} data-i={k} aria-label={`Visuel ${k + 1}`}></button>
      ))}
    </div>
    <div class="hero__inner">
      <div class="reveal in">
        <span class="eyebrow" style="color:rgba(246,244,239,.66)">{d.eyebrow}</span>
        <h1 style="margin-top:16px">{d.h1}</h1>
        <p class="hero__sub">{d.sub}</p>
        <div class="hero__cta">
          <a class="btn btn--light" href={`${isEn ? "/en" : ""}/contact?type=${route}`}>{isEn ? "Get in touch" : "Nous contacter"} <span class="arr">→</span></a>
          <a class="btn btn--ghost-light" href={isEn ? "/en/references" : "/references"}>{isEn ? "References" : "Références"} <span class="arr">→</span></a>
        </div>
      </div>
    </div>
  </section>

  {/* QUALIF (sécurité uniquement) */}
  {d.qualif && (
    <section class="section section--tight">
      <div class="wrap split">
        <div class="reveal col-head">
          <span class="eyebrow">Une qualification rare</span>
          <h2>{d.qualif.big}</h2>
        </div>
        <div>
          {d.qualif.body.map((p, i) => (
            <p class={"reveal" + (i === 0 ? " lead" : "")} data-d={i + 1} style={`margin-top:${i === 0 ? 0 : 22}px`}>{p}</p>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* PÉRIMÈTRE */}
  <section class="section" style={`background:${d.qualif ? "var(--paper-2)" : "var(--paper)"}`}>
    <div class="wrap split">
      <div class="reveal col-head">
        <span class="eyebrow">Périmètre</span>
        <h2>{d.perimTitle}</h2>
        {d.perimLead && <p>{d.perimLead}</p>}
      </div>
      <ul class="reveal clist" data-d="1">
        {d.perim.map((li) => <li>{li}</li>)}
      </ul>
    </div>
  </section>

  {/* OPÉRATIONS / INTERLOCUTEURS */}
  <section class="section section--tight" style={`background:${d.qualif ? "var(--paper)" : "var(--paper-2)"}`}>
    <div class="wrap">
      <div class="reveal" style="max-width:60ch;margin-bottom:34px">
        <span class="eyebrow">{isSecu ? "Autorités" : "Couverture"}</span>
        <h2 class="display" style="font-size:clamp(24px,2.6vw,38px);margin-top:16px;line-height:1.1">{d.opsTitle}</h2>
        {d.opsLead && <p class="lead" style="margin-top:16px">{d.opsLead}</p>}
      </div>
      {isSecu ? (
        <div class="reveal chips" data-d="1">{d.ops.map((o) => <span class="chip">{o}</span>)}</div>
      ) : (
        <ul class="reveal clist clist--num clist--cols" data-d="1">
          {d.ops.map((o) => <li style="break-inside:avoid">{o}</li>)}
        </ul>
      )}
    </div>
  </section>

  {/* PROCESS */}
  <section class="section">
    <div class="wrap">
      <div class="reveal" style="max-width:56ch;margin-bottom:34px">
        <span class="eyebrow">Comment ça se passe</span>
        <h2 class="display" style="font-size:clamp(24px,2.6vw,38px);margin-top:16px;line-height:1.1">Du cadrage à la restitution du lieu.</h2>
      </div>
      <div class="process">
        {PROCESS.map((p, i) => (
          <div class="pstep reveal" data-d={i + 1}>
            <div class="pstep__n">{p.n}</div>
            <div class="pstep__t">{p.t}</div>
            <div class="pstep__d">{p.d}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* MODÈLE D'INTERVENTION */}
  <section class="section section--tight" style="background:var(--paper-2)">
    <div class="wrap split">
      <div class="reveal col-head">
        <span class="eyebrow">Modèle d'intervention</span>
        <h2>Ponctuel ou récurrent. Seul ou en complément.</h2>
      </div>
      <div>
        {d.model.map((p, i) => (
          <p class={"reveal" + (i === 0 ? " lead" : "")} data-d={i + 1} style={`margin-top:${i === 0 ? 0 : 22}px`}>{p}</p>
        ))}
      </div>
    </div>
  </section>

  {/* RÉFÉRENCES */}
  <section class="section section--tight" style="background:var(--pale)">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:36px;display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:20px">
        <div>
          <span class="eyebrow">Références</span>
          <h2 class="display" style="font-size:clamp(24px,2.6vw,38px);margin-top:16px">Quelques productions d'ESE.</h2>
        </div>
        <a class="btn btn--ghost" href={isEn ? "/en/references" : "/references"}>{isEn ? "All references" : "Voir toutes les références"} <span class="arr">→</span></a>
      </div>
      <RefList lang={lang} />
    </div>
  </section>

  <ContactBanner lang={lang} />
</BaseLayout>

<script>
  // Carrousel hero métier
  const slides = Array.from(document.querySelectorAll("#hero-bg .hero__slide"));
  const dots = Array.from(document.querySelectorAll("#hero-dots .hero__dot"));
  const index = document.getElementById("hero-index");
  let cur = 0, timer;
  const total = slides.length;
  function show(n) {
    cur = (n + total) % total;
    slides.forEach((s, k) => s.classList.toggle("on", k === cur));
    dots.forEach((d, k) => d.classList.toggle("on", k === cur));
    if (index) index.textContent = String(cur + 1).padStart(2, "0") + " / " + String(total).padStart(2, "0");
  }
  function start() { timer = setInterval(() => show(cur + 1), 6500); }
  dots.forEach((d) =>
    d.addEventListener("click", () => { clearInterval(timer); show(Number(d.dataset.i)); start(); })
  );
  if (total > 1) start();
</script>
