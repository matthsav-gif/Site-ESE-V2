---
import { REF_LIST as REF_LIST_FR } from "../data/site.js";
import { REF_LIST as REF_LIST_EN } from "../data/site.en.js";
const { lang = "fr" } = Astro.props;
const REF_LIST = lang === "en" ? REF_LIST_EN : REF_LIST_FR;
---
<div class="kgrid">
  {REF_LIST.map((it, k) => (
    <div class="kcell reveal" data-d={(k % 3) + 1}>
      <div class="mono">{String(k + 1).padStart(2, "0")}</div>
      <h4>{it.t}</h4>
      <p>{it.d}</p>
    </div>
  ))}
</div>
